<?xml version="1.0"?>
<!--
  cakebot 基础机器人模型

  坐标约定：
    x：机器人前方为正，后方为负
    y：机器人左方为正，右方为负
    z：向上为正

  本文件刻意把几何尺寸、质量和组件位置集中在顶部，方便在实物尺寸
  尚未完全确定时调整。模型包含可用于 Gazebo 的 visual、collision 和
  inertial 数据；Gazebo 插件负责仿真中的运动控制和里程计发布。

  感知仿真支持两种互斥模式：
    laser_2d：保留阶段 5–8 的二维雷达，直接发布 /scan；
    mid360_sim：近似模拟 MID-360 的水平/垂直视场，只发布
                /lidar/points_raw（PointCloud2），再由 cakebot_perception
                投影为建图和定位使用的 /scan。
  mid360_sim 用于验证 ROS 接口和适配链路，不模拟真机的扫描模式、
  反射率、噪声或运动畸变，也不在此文件中实现三维避障。
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="cakebot">

  <!-- ================================================================
       可配置参数
       ================================================================ -->

  <!-- 底盘尺寸 -->
  <xacro:arg name="base_length" default="0.32"/>
  <xacro:arg name="base_width" default="0.24"/>
  <xacro:arg name="base_height" default="0.10"/>
  <xacro:arg name="base_z" default="0.085"/>
  <xacro:arg name="base_mass" default="2.0"/>

  <!-- 驱动轮尺寸与位置 -->
  <xacro:arg name="wheel_radius" default="0.05"/>
  <xacro:arg name="wheel_width" default="0.025"/>
  <xacro:arg name="wheel_separation" default="0.22"/>
  <xacro:arg name="wheel_x" default="0.0"/>
  <xacro:arg name="wheel_z" default="0.05"/>
  <xacro:arg name="wheel_mass" default="0.15"/>
  <xacro:arg name="wheel_damping" default="0.01"/>

  <!--
    万向轮位置：
      caster_x > 0：前方
      caster_x < 0：后方
    例如：把 default="-0.12" 改成 default="0.12"，即可把万向轮
    从后方移动到前方。
  -->
  <xacro:arg name="caster_radius" default="0.025"/>
  <xacro:arg name="caster_x" default="-0.12"/>
  <xacro:arg name="caster_y" default="0.0"/>
  <xacro:arg name="caster_z" default="0.025"/>
  <xacro:arg name="caster_yaw" default="0.0"/>
  <xacro:arg name="caster_mass" default="0.08"/>

  <!-- 激光雷达尺寸与安装位置 -->
  <xacro:arg name="laser_radius" default="0.035"/>
  <xacro:arg name="laser_height" default="0.04"/>
  <xacro:arg name="laser_x" default="0.10"/>
  <xacro:arg name="laser_y" default="0.0"/>
  <xacro:arg name="laser_z" default="0.17"/>
  <xacro:arg name="laser_mass" default="0.08"/>

  <!--
    感知模式：
      laser_2d  : 保留原有的二维 LaserScan 传感器；
      mid360_sim: 使用带垂直扫描的三维仿真雷达，输出 PointCloud2。
    两种模式只能同时启用一种，避免产生两个传感器发布同一个接口。
  -->
  <xacro:arg name="sensor_mode" default="laser_2d"/>
  <!-- 是否在 Gazebo GUI 中绘制雷达射线；不影响传感器消息发布。 -->
  <xacro:arg name="visualize_lidar" default="true"/>
  <xacro:arg name="mid360_update_rate" default="10.0"/>
  <xacro:arg name="mid360_horizontal_samples" default="360"/>
  <!-- 仿真默认用 16 条垂直采样保持 Gazebo 在普通电脑上接近10 Hz；真机点云密度由驱动器决定。 -->
  <xacro:arg name="mid360_vertical_samples" default="16"/>
  <xacro:arg name="mid360_min_vertical_angle" default="-0.1221730476"/>
  <xacro:arg name="mid360_max_vertical_angle" default="0.9075712110"/>
  <xacro:arg name="mid360_min_range" default="0.10"/>
  <xacro:arg name="mid360_max_range" default="40.0"/>
  <xacro:arg name="mid360_range_resolution" default="0.01"/>
  <xacro:arg name="mid360_points_topic" default="lidar/points_raw"/>

  <!-- 激光雷达扫描参数 -->
  <xacro:arg name="laser_update_rate" default="10.0"/>
  <xacro:arg name="laser_samples" default="360"/>
  <xacro:arg name="laser_min_angle" default="-3.14159265359"/>
  <xacro:arg name="laser_max_angle" default="3.14159265359"/>
  <xacro:arg name="laser_min_range" default="0.12"/>
  <xacro:arg name="laser_max_range" default="8.0"/>
  <xacro:arg name="laser_range_resolution" default="0.01"/>

  <!--
    将可由命令行覆盖的 xacro:arg 映射为内部属性。
    之后只使用这些属性，避免把外部参数和模型计算混在一起。
  -->
  <xacro:property name="base_length" value="$(arg base_length)"/>
  <xacro:property name="base_width" value="$(arg base_width)"/>
  <xacro:property name="base_height" value="$(arg base_height)"/>
  <xacro:property name="base_z" value="$(arg base_z)"/>
  <xacro:property name="base_mass" value="$(arg base_mass)"/>

  <xacro:property name="wheel_radius" value="$(arg wheel_radius)"/>
  <xacro:property name="wheel_width" value="$(arg wheel_width)"/>
  <xacro:property name="wheel_separation" value="$(arg wheel_separation)"/>
  <xacro:property name="wheel_x" value="$(arg wheel_x)"/>
  <xacro:property name="wheel_z" value="$(arg wheel_z)"/>
  <xacro:property name="wheel_mass" value="$(arg wheel_mass)"/>
  <xacro:property name="wheel_damping" value="$(arg wheel_damping)"/>

  <xacro:property name="caster_radius" value="$(arg caster_radius)"/>
  <xacro:property name="caster_x" value="$(arg caster_x)"/>
  <xacro:property name="caster_y" value="$(arg caster_y)"/>
  <xacro:property name="caster_z" value="$(arg caster_z)"/>
  <xacro:property name="caster_yaw" value="$(arg caster_yaw)"/>
  <xacro:property name="caster_mass" value="$(arg caster_mass)"/>

  <xacro:property name="laser_radius" value="$(arg laser_radius)"/>
  <xacro:property name="laser_height" value="$(arg laser_height)"/>
  <xacro:property name="laser_x" value="$(arg laser_x)"/>
  <xacro:property name="laser_y" value="$(arg laser_y)"/>
  <xacro:property name="laser_z" value="$(arg laser_z)"/>
  <xacro:property name="laser_mass" value="$(arg laser_mass)"/>

  <xacro:property name="sensor_mode" value="$(arg sensor_mode)"/>
  <xacro:property name="visualize_lidar" value="$(arg visualize_lidar)"/>
  <xacro:property name="mid360_update_rate" value="$(arg mid360_update_rate)"/>
  <xacro:property name="mid360_horizontal_samples" value="$(arg mid360_horizontal_samples)"/>
  <xacro:property name="mid360_vertical_samples" value="$(arg mid360_vertical_samples)"/>
  <xacro:property name="mid360_min_vertical_angle" value="$(arg mid360_min_vertical_angle)"/>
  <xacro:property name="mid360_max_vertical_angle" value="$(arg mid360_max_vertical_angle)"/>
  <xacro:property name="mid360_min_range" value="$(arg mid360_min_range)"/>
  <xacro:property name="mid360_max_range" value="$(arg mid360_max_range)"/>
  <xacro:property name="mid360_range_resolution" value="$(arg mid360_range_resolution)"/>
  <xacro:property name="mid360_points_topic" value="$(arg mid360_points_topic)"/>

  <xacro:property name="laser_update_rate" value="$(arg laser_update_rate)"/>
  <xacro:property name="laser_samples" value="$(arg laser_samples)"/>
  <xacro:property name="laser_min_angle" value="$(arg laser_min_angle)"/>
  <xacro:property name="laser_max_angle" value="$(arg laser_max_angle)"/>
  <xacro:property name="laser_min_range" value="$(arg laser_min_range)"/>
  <xacro:property name="laser_max_range" value="$(arg laser_max_range)"/>
  <xacro:property name="laser_range_resolution" value="$(arg laser_range_resolution)"/>

  <!-- ================================================================
       可复用宏
       ================================================================ -->

  <!-- 长方体惯性，x/y/z 为长方体三个方向的尺寸 -->
  <xacro:macro name="box_inertial" params="mass x y z origin_z">
    <inertial>
      <origin xyz="0 0 ${origin_z}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y * y + z * z) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (x * x + z * z) / 12.0}"
        iyz="0.0"
        izz="${mass * (x * x + y * y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <!-- 圆柱惯性：宏内部默认圆柱轴线为 z 轴。 -->
  <xacro:macro name="cylinder_inertial" params="mass radius length origin_rpy">
    <inertial>
      <origin xyz="0 0 0" rpy="${origin_rpy}"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0 * radius * radius + length * length) / 12.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${mass * (3.0 * radius * radius + length * length) / 12.0}"
        iyz="0.0"
        izz="${mass * radius * radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <!-- 球体惯性。球体的质心位于 link 原点。 -->
  <xacro:macro name="sphere_inertial" params="mass radius">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${2.0 * mass * radius * radius / 5.0}"
        ixy="0.0"
        ixz="0.0"
        iyy="${2.0 * mass * radius * radius / 5.0}"
        iyz="0.0"
        izz="${2.0 * mass * radius * radius / 5.0}"/>
    </inertial>
  </xacro:macro>

  <!-- 差速驱动轮。y 为轮轴中心相对于 base_link 的横向位置。 -->
  <xacro:macro name="drive_wheel" params="side y">
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>

      <!-- 惯性坐标系随圆柱一起绕 x 轴旋转，使圆柱轴线为 y 轴。 -->
      <xacro:cylinder_inertial
        mass="${wheel_mass}"
        radius="${wheel_radius}"
        length="${wheel_width}"
        origin_rpy="${pi / 2.0} 0 0"/>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${side}_wheel_link"/>
      <origin xyz="${wheel_x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="${wheel_damping}" friction="0.0"/>
    </joint>
  </xacro:macro>

  <!-- ================================================================
       材质
       ================================================================ -->

  <material name="cakebot_blue">
    <color rgba="0.10 0.35 0.80 1.0"/>
  </material>

  <material name="wheel_black">
    <color rgba="0.04 0.04 0.04 1.0"/>
  </material>

  <material name="caster_gray">
    <color rgba="0.45 0.45 0.45 1.0"/>
  </material>

  <material name="laser_black">
    <color rgba="0.02 0.02 0.02 1.0"/>
  </material>

  <!-- ================================================================
       机器人主体
       ================================================================ -->

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="cakebot_blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>

    <xacro:box_inertial
      mass="${base_mass}"
      x="${base_length}"
      y="${base_width}"
      z="${base_height}"
      origin_z="${base_z}"/>
  </link>

  <!-- 左右驱动轮：左为 +y，右为 -y。 -->
  <xacro:drive_wheel side="left" y="${wheel_separation / 2.0}"/>
  <xacro:drive_wheel side="right" y="${-wheel_separation / 2.0}"/>

  <!--
    简化万向轮：当前使用球体表示，采用 fixed joint。
    caster_x/caster_y/caster_z/caster_yaw 均可直接调整。
    当前用简化球体保证仿真模型闭合；实物尺寸确定后，再替换为真实
    的万向轮支架和碰撞几何。
  -->
  <link name="caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="caster_gray"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>

    <xacro:sphere_inertial mass="${caster_mass}" radius="${caster_radius}"/>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} ${caster_y} ${caster_z}" rpy="0 0 ${caster_yaw}"/>
  </joint>

  <!-- 激光雷达安装座。雷达坐标系 z 轴向上，x 轴指向机器人前方。 -->
  <link name="laser_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${laser_radius}" length="${laser_height}"/>
      </geometry>
      <material name="laser_black"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${laser_radius}" length="${laser_height}"/>
      </geometry>
    </collision>

    <xacro:cylinder_inertial
      mass="${laser_mass}"
      radius="${laser_radius}"
      length="${laser_height}"
      origin_rpy="0 0 0"/>
  </link>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser_link"/>
    <origin xyz="${laser_x} ${laser_y} ${laser_z}" rpy="0 0 0"/>
  </joint>

  <!--
    Gazebo Classic 二维激光雷达。扫描结果发布到 /scan。
    这是默认模式，用于保持阶段 5–8 的旧流程可回归。
  -->
  <xacro:if value="${sensor_mode == 'laser_2d'}">
    <gazebo reference="laser_link">
      <sensor name="cakebot_laser" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <visualize>${visualize_lidar}</visualize>
        <update_rate>${laser_update_rate}</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>${laser_samples}</samples>
              <resolution>1</resolution>
              <min_angle>${laser_min_angle}</min_angle>
              <max_angle>${laser_max_angle}</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>${laser_min_range}</min>
            <max>${laser_max_range}</max>
            <resolution>${laser_range_resolution}</resolution>
          </range>
        </ray>

        <plugin name="cakebot_laser_sensor" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=scan</remapping>
          </ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>laser_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

  <!--
    Gazebo Classic MID-360 近似仿真：水平 360 度、垂直 -7 度到 52 度。
    输出为 sensor_msgs/PointCloud2，供 cakebot_perception 转换为 /scan。
    这个模式不直接发布 /scan，避免与点云适配器重复。
  -->
  <xacro:if value="${sensor_mode == 'mid360_sim'}">
    <gazebo reference="laser_link">
      <sensor name="cakebot_mid360" type="ray">
        <pose>0 0 0 0 0 0</pose>
        <visualize>${visualize_lidar}</visualize>
        <update_rate>${mid360_update_rate}</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>${mid360_horizontal_samples}</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
            <vertical>
              <samples>${mid360_vertical_samples}</samples>
              <resolution>1</resolution>
              <min_angle>${mid360_min_vertical_angle}</min_angle>
              <max_angle>${mid360_max_vertical_angle}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${mid360_min_range}</min>
            <max>${mid360_max_range}</max>
            <resolution>${mid360_range_resolution}</resolution>
          </range>
        </ray>

        <plugin name="cakebot_mid360_sensor" filename="libgazebo_ros_ray_sensor.so">
          <ros>
            <remapping>~/out:=${mid360_points_topic}</remapping>
          </ros>
          <output_type>sensor_msgs/PointCloud2</output_type>
          <frame_name>laser_link</frame_name>
        </plugin>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- ================================================================
       Gazebo Classic 差速驱动插件

       该插件把 /cmd_vel 转换成左右驱动轮的角速度，并发布 /odom
       以及 odom -> base_link TF。
       ================================================================ -->
  <gazebo>
    <plugin name="cakebot_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>

      <!-- 驱动轮关节 -->
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <!-- 差速运动学参数 -->
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_diameter>${2.0 * wheel_radius}</wheel_diameter>

      <!-- 电机仿真限制 -->
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>

      <!-- 输出 -->
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <update_rate>50</update_rate>
    </plugin>
  </gazebo>

</robot>
